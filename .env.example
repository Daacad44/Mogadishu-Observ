# Supabase (Vite — exposed to client)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-only (Vercel functions)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Earth Engine
GEE_SERVICE_ACCOUNT_EMAIL=your-gee-service-account@project.iam.gserviceaccount.com
GEE_PRIVATE_KEY=your-gee-private-key-json

# App
VITE_APP_URL=http://localhost:5173
VITE_APP_NAME=Mogadishu Urban Growth Observatory

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Database setup (run in Supabase SQL Editor, in order):
# 1. supabase/migrations/001_initial_schema.sql
# 2. supabase/migrations/002_super_admin.sql
# 3. supabase/migrations/003_seed_data.sql
# 4. supabase/migrations/004_contact_messages.sql
# Full reference: supabase/schema.sql
